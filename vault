#!/bin/bash
# ============================================================
# Termux Text Vault — Remote CLI Client
# ============================================================
# Install on any VPS/server:
#   curl -sL <raw_github_url>/vault > /usr/local/bin/vault
#   chmod +x /usr/local/bin/vault
#   vault setup
# ============================================================

CONFIG_FILE="$HOME/.vault_config"

# Color constants
G='\033[0;32m'   # Green
B='\033[0;34m'   # Blue
R='\033[0;31m'   # Red
Y='\033[1;33m'   # Yellow
C='\033[0;36m'   # Cyan
DIM='\033[2m'    # Dim
BOLD='\033[1m'   # Bold
NC='\033[0m'     # Reset

# --- Configuration ---
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        source "$CONFIG_FILE"
    fi
}

save_config() {
    cat > "$CONFIG_FILE" << EOF
VAULT_URL="$VAULT_URL"
VAULT_USER="$VAULT_USER"
VAULT_PASS="$VAULT_PASS"
EOF
    chmod 600 "$CONFIG_FILE"
}

do_setup() {
    echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}  📦 Vault Remote Client — Setup${NC}"
    echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    read -p "Vault URL (e.g. https://xxx.trycloudflare.com): " VAULT_URL
    VAULT_URL="${VAULT_URL%/}"  # Remove trailing slash
    read -p "Username: " VAULT_USER
    read -s -p "Password: " VAULT_PASS
    echo ""

    # Test connection
    echo -ne "\n${DIM}Testing connection...${NC} "
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -u "$VAULT_USER:$VAULT_PASS" "$VAULT_URL/api/health" 2>/dev/null)

    if [ "$HTTP_CODE" = "200" ]; then
        save_config
        echo -e "${G}✔ Connected successfully!${NC}"
        echo -e "${DIM}Config saved to $CONFIG_FILE${NC}"
    else
        echo -e "${R}✖ Connection failed (HTTP $HTTP_CODE)${NC}"
        echo -e "${DIM}Check your URL and credentials.${NC}"
        return 1
    fi
}

check_config() {
    if [ -z "$VAULT_URL" ] || [ -z "$VAULT_USER" ] || [ -z "$VAULT_PASS" ]; then
        echo -e "${R}Not configured. Run: vault setup${NC}"
        exit 1
    fi
}

# --- API calls ---
api_get() {
    curl -sf -u "$VAULT_USER:$VAULT_PASS" "$VAULT_URL$1" 2>/dev/null
}

api_post() {
    curl -sf -u "$VAULT_USER:$VAULT_PASS" \
        -X POST -H "Content-Type: application/json" \
        -d "$2" "$VAULT_URL$1" 2>/dev/null
}

api_delete() {
    curl -sf -u "$VAULT_USER:$VAULT_PASS" -X DELETE "$VAULT_URL$1" 2>/dev/null
}

extract_content() {
    python3 -c "import sys,json; print(json.load(sys.stdin)['content'])" 2>/dev/null
}

json_escape_stdin() {
    python3 -c "import json,sys; print(json.dumps(sys.stdin.read()))" 2>/dev/null
}

# --- Commands ---
do_pull() {
    RESULT=$(api_get "/api/pull")
    if [ $? -ne 0 ] || [ -z "$RESULT" ]; then
        echo -e "${R}Vault is empty or connection failed.${NC}"
        return 1
    fi
    echo "$RESULT" | extract_content
}

do_push_stdin() {
    CONTENT=$(json_escape_stdin)
    RESULT=$(api_post "/api/push" "{\"content\": $CONTENT}")
    if echo "$RESULT" | grep -q '"success"'; then
        echo -e "${G}✔ Pushed successfully.${NC}"
    else
        echo -e "${R}✖ Push failed.${NC}"
        return 1
    fi
}

do_push_text() {
    local TEXT="$1"
    CONTENT=$(echo "$TEXT" | json_escape_stdin)
    RESULT=$(api_post "/api/push" "{\"content\": $CONTENT}")
    if echo "$RESULT" | grep -q '"success"'; then
        echo -e "${G}✔ Pushed successfully.${NC}"
    else
        echo -e "${R}✖ Push failed.${NC}"
        return 1
    fi
}

do_list() {
    RESULT=$(api_get "/api/archive")
    if [ -z "$RESULT" ] || [ "$RESULT" = "[]" ]; then
        echo -e "${DIM}Archive is empty.${NC}"
        return
    fi
    python3 -c "
import json, sys
data = json.load(sys.stdin)
print()
print('  \033[1m ID  │ Size      │ Date              │ Preview\033[0m')
print('  ────┼───────────┼───────────────────┼─────────────────────────────')
for item in data:
    sid = str(item['id']).rjust(3)
    size = item.get('size', 0)
    if size < 1024:
        sz = f'{size} B'
    elif size < 1048576:
        sz = f'{size/1024:.1f} KB'
    else:
        sz = f'{size/1048576:.1f} MB'
    sz = sz.rjust(7)
    dt = item.get('created_at', '')[:16].replace('T', ' ')
    preview = item.get('preview', '')[:30].replace('\n', ' ')
    print(f'  {sid} │ {sz}   │ {dt} │ {preview}')
print()
" <<< "$RESULT"
}

do_get() {
    local ID="$1"
    RESULT=$(api_get "/api/archive/$ID")
    if [ $? -ne 0 ] || [ -z "$RESULT" ]; then
        echo -e "${R}Entry #$ID not found.${NC}"
        return 1
    fi
    echo "$RESULT" | extract_content
}

do_delete() {
    local ID="$1"
    RESULT=$(api_delete "/api/archive/$ID")
    if echo "$RESULT" | grep -q '"deleted"'; then
        echo -e "${G}✔ Entry #$ID deleted.${NC}"
    else
        echo -e "${R}✖ Delete failed.${NC}"
        return 1
    fi
}

do_interactive() {
    check_config
    while true; do
        echo ""
        echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${BOLD}  📦 Vault ${DIM}— $VAULT_URL${NC}"
        echo -e "${B}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo -e "  ${G}1${NC}) Pull latest       ${G}4${NC}) List archive"
        echo -e "  ${G}2${NC}) Push text          ${G}5${NC}) Get by ID"
        echo -e "  ${G}3${NC}) Push file          ${G}6${NC}) Delete by ID"
        echo ""
        echo -e "  ${G}s${NC}) Setup              ${G}q${NC}) Quit"
        echo ""
        read -p "  Choose: " choice

        case "$choice" in
            1)
                echo ""
                echo -e "${C}── Latest entry ──────────────────────${NC}"
                do_pull
                echo -e "${C}──────────────────────────────────────${NC}"
                ;;
            2)
                echo ""
                echo -e "${DIM}Type or paste your text. Press Ctrl+D when done:${NC}"
                echo -e "${C}──────────────────────────────────────${NC}"
                do_push_stdin
                ;;
            3)
                read -p "  File path: " filepath
                if [ -f "$filepath" ]; then
                    do_push_stdin < "$filepath"
                else
                    echo -e "${R}File not found: $filepath${NC}"
                fi
                ;;
            4)
                do_list
                ;;
            5)
                read -p "  Entry ID: " eid
                echo ""
                echo -e "${C}── Entry #$eid ───────────────────────${NC}"
                do_get "$eid"
                echo -e "${C}──────────────────────────────────────${NC}"
                ;;
            6)
                read -p "  Entry ID to delete: " eid
                read -p "  Confirm delete #$eid? (y/N): " confirm
                if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
                    do_delete "$eid"
                fi
                ;;
            s|S)
                do_setup
                load_config
                ;;
            q|Q|"")
                echo -e "${DIM}Bye.${NC}"
                exit 0
                ;;
            *)
                echo -e "${R}Invalid choice.${NC}"
                ;;
        esac
    done
}

# --- Help ---
show_help() {
    echo ""
    echo -e "${BOLD}Termux Text Vault — Remote CLI Client${NC}"
    echo ""
    echo -e "  ${BOLD}SETUP${NC}"
    echo "    vault setup                  Configure URL and credentials"
    echo ""
    echo -e "  ${BOLD}INTERACTIVE MODE${NC}"
    echo "    vault                        Open interactive menu"
    echo ""
    echo -e "  ${BOLD}DIRECT COMMANDS${NC}"
    echo "    vault pull                   Print latest entry to stdout"
    echo "    vault pull > file.sh         Save latest entry to file"
    echo "    vault push \"some text\"        Push inline text"
    echo "    vault push < file.txt        Push file content"
    echo "    cat log.txt | vault push     Pipe content to push"
    echo "    vault list                   Show archive table"
    echo "    vault get 3                  Print entry #3"
    echo "    vault get 3 > out.txt        Save entry #3 to file"
    echo "    vault delete 3               Delete entry #3"
    echo ""
    echo -e "  ${BOLD}EXAMPLES${NC}"
    echo "    vault pull > deploy.sh && bash deploy.sh"
    echo "    cat /var/log/syslog | tail -50 | vault push"
    echo "    vault push \"apt update && apt install nginx -y\""
    echo ""
}

# --- Main ---
load_config

case "${1:-}" in
    setup)
        do_setup
        ;;
    pull)
        check_config
        do_pull
        ;;
    push)
        check_config
        if [ -n "$2" ]; then
            do_push_text "$2"
        elif [ ! -t 0 ]; then
            # stdin is piped
            do_push_stdin
        else
            echo -e "${DIM}Type or paste text. Press Ctrl+D when done:${NC}"
            do_push_stdin
        fi
        ;;
    list|ls|archive)
        check_config
        do_list
        ;;
    get)
        check_config
        if [ -z "$2" ]; then
            echo -e "${R}Usage: vault get <id>${NC}"
            exit 1
        fi
        do_get "$2"
        ;;
    delete|rm)
        check_config
        if [ -z "$2" ]; then
            echo -e "${R}Usage: vault delete <id>${NC}"
            exit 1
        fi
        do_delete "$2"
        ;;
    help|-h|--help)
        show_help
        ;;
    "")
        check_config
        do_interactive
        ;;
    *)
        echo -e "${R}Unknown command: $1${NC}"
        show_help
        exit 1
        ;;
esac
